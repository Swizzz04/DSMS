# Environment files — real ones hold backend URLs / future secrets and must never be committed.
# Keep the template (.env.example) tracked. NOTE: any VITE_* variable is compiled into the
# public browser bundle, so never put a secret in one.
.env
.env.*
!.env.example

# Archives, local backups and scratch files (src.zip was committed several times before)
*.zip
*.rar
*.7z
*.bak
*.orig
