# Copy this file to .env.local (never commit .env.local) and set your backend URL.
# Restart `npm run dev` after changing it — Vite reads env files at startup.
#
# Must end at the API root, without a trailing slash. Examples:
#   https://localhost:7123/api      (ASP.NET Core dev server, https profile)
#   http://localhost:5123/api       (ASP.NET Core dev server, http profile)
#   https://api.yourschool.example/api   (production)
#
# Leave empty to run on local/offline data with no backend.
VITE_API_BASE_URL=
