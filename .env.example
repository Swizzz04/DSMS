# ALMIRENE DX — environment variables
# Copy this file to `.env.local` (gitignored) for your own machine, or set the same names in the
# hosting service for a deployed build. Vite only exposes names that start with VITE_, and
# everything exposed ends up readable in the browser, so never put a real secret here.

# ── Backend ──────────────────────────────────────────────────────────
# Where the ASP.NET Core API lives. Leave empty to keep running on local (offline) data.
VITE_API_BASE_URL=

# ── Login accounts ───────────────────────────────────────────────────
# `npm run dev` always loads the sample (demo) accounts. A production build does NOT.
#
# Option 1 — a real school: start with one Technical Administrator, who then creates the real
# accounts in Settings → Users.
#   VITE_BOOTSTRAP_ADMIN_EMAIL = the login email
#   VITE_BOOTSTRAP_ADMIN_HASH  = SHA-256 hex of the password (64 characters). Make it with:
#       node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "YourStrongPassword1"
#   Choose a long, unique password. This is a stopgap until the backend owns passwords: the hash is
#   visible in the built files, so change this password as soon as you are logged in.
VITE_BOOTSTRAP_ADMIN_EMAIL=
VITE_BOOTSTRAP_ADMIN_HASH=

# Option 2 — a demo or sales site only: load the sample accounts (their passwords are public).
# Never set this to true for a real school.
VITE_DEMO_ACCOUNTS=false
